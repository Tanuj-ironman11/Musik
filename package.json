{
  "name": "musik",
  "version": "0.1.0",
  "description": "Local-file desktop music player with native mod/theme support",
  "main": "main.js",
  "author": "Godzilla",
  "license": "GPL-3.0-or-later",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac"
  },
  "dependencies": {
    "music-metadata": "11.15.0",
    "node-id3": "^0.2.9",
    "node-taglib-sharp": "^6.0.3",
    "three": "0.160.0"
  },
  "devDependencies": {
    "electron": "43.4.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.musik.app",
    "productName": "Musik",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "src/**/*",
      "!mods/**",
      "node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "bin",
        "to": "bin",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico",
      "files": [
        "native/wasapi-loopback/index.js",
        "native/wasapi-loopback/build/Release/wasapi_loopback.node"
      ]
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icon.icns",
      "category": "public.app-category.music"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "allowScripts": {
    "electron@43.4.1": true,
    "electron-winstaller@5.4.0": true
  }
}
