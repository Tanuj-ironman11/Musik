{
  "name": "musik",
  "version": "0.1.0",
  "description": "Local-file desktop music player with native mod/theme support",
  "main": "main.js",
  "author": "Tanuj-ironman11",
  "license": "GPL-3.0-or-later",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac"
  },
  "dependencies": {
    "@audio/decode-aac": "^1.5.0",
    "@fontsource/nunito": "^5.3.0",
    "@fontsource/space-mono": "^5.3.0",
    "dompurify": "^3.4.15",
    "kuroshiro": "^1.2.0",
    "kuroshiro-analyzer-kuromoji": "^1.1.0",
    "music-metadata": "11.15.0",
    "node-id3": "^0.2.9",
    "node-taglib-sharp": "^6.0.3",
    "pinyin-pro": "^3.29.4",
    "three": "0.186.0"
  },
  "devDependencies": {
    "electron": "44.4.3",
    "electron-builder": "^26.16.1"
  },
  "build": {
    "appId": "com.musik.app",
    "productName": "Musik",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "asarUnpack": [
      "node_modules/kuromoji/dict/**/*",
      "node_modules/kuroshiro-analyzer-kuromoji/node_modules/kuromoji/dict/**/*"
    ],
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "src/**/*",
      "!mods/**",
      "node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "bin",
        "to": "bin",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico",
      "files": [
        "native/wasapi-loopback/index.js",
        "native/wasapi-loopback/build/Release/wasapi_loopback.node"
      ]
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icon.icns",
      "category": "public.app-category.music"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "allowScripts": {
    "electron@44.4.3": true,
    "electron-winstaller@5.4.0": true
  }
}
